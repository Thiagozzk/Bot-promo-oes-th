PORT=3000
ADMIN_KEY=troque-por-uma-senha-forte
TARGET_GROUPS=Nome exato do seu grupo
MIN_DISCOUNT=30
SCAN_MINUTES=15
MAX_SEND_PER_SCAN=5
AUTO_SEND=false

# Palavras pesquisadas
SEARCH_TERMS=placa de video,rtx,rx 6600,ryzen,processador intel,ssd nvme,memoria ram ddr4,memoria ram ddr5,monitor gamer,mouse gamer,teclado mecanico,headset gamer,fonte pc,gabinete gamer,water cooler

# Mercado Livre - crie uma aplicacao e informe um access token.
ML_ACCESS_TOKEN=

# AliExpress Affiliate/Open Platform
ALIEXPRESS_APP_KEY=
ALIEXPRESS_APP_SECRET=
ALIEXPRESS_TRACKING_ID=
ALIEXPRESS_API_URL=https://api-sg.aliexpress.com/sync

# Feed extra opcional (Shopee, Amazon, Terabyte etc.)
# Deve retornar um array JSON ou {"offers":[...]}.
CUSTOM_FEED_URL=
CUSTOM_FEED_TOKEN=
